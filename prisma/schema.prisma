// Nexus — zentrale Stammdaten (KONZEPT.md §3.3)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Mandant (eigene Firma) ----
model Organization {
  id           String  @id @default(cuid())
  name         String
  nameAddition String  @default("")   // Namenszusatz, z. B. "Inh. David Baier"
  shortCode    String  @default("")
  street    String  @default("")
  zip       String  @default("")
  city      String  @default("")
  country   String  @default("Deutschland")
  taxNumber String  @default("")
  ustId     String  @default("")
  logo      String  @default("") @db.Text  // Mandanten-Logo/-symbol (base64 data URL), asynchron geladen
  version   Int      @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  numbers   CustomerNumber[]
}

// ---- Kunde (Superset kontor.Client + clocker.Client) ----
model Customer {
  id          String  @id @default(cuid())
  companyName String  @default("")
  contactName String  @default("")
  salutation  String  @default("")
  shortCode   String  @default("")
  color       String  @default("#3b82f6")
  street      String  @default("")
  zip         String  @default("")
  city        String  @default("")
  country     String  @default("Deutschland")
  addressFree String  @default("")
  email       String  @default("")
  phone       String  @default("")
  taxNumber   String  @default("")
  ustId       String  @default("")
  distanceKm  Float   @default(0)
  notes       String  @default("")
  logo        String  @default("") @db.Text  // Firmenlogo/-symbol (base64 data URL), asynchron geladen
  contacts       Contact[]                     // zentrales Kontaktregister
  legacyContacts CustomerContact[]              // Altbestand vor der Zentralisierung (nur Archiv)
  numbers     CustomerNumber[]
  projects    Project[]
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyName])
  @@index([shortCode])
}

// Zentraler Artikelstamm (Kernfelder). Preis/MwSt bleiben in kontor, Lieferanten-/
// Hersteller-Nr. in ProjectEye lokal. `number` = zentrale, fortlaufende Stammnummer,
// wird ausschließlich von Nexus beim POST vergeben (höchste + 1, transaktional).
model Product {
  id          String    @id @default(cuid())
  number      Int       @unique
  name        String    @default("")
  description String    @default("")
  unit        String    @default("Stk.")
  category    String    @default("")
  active      Boolean   @default(true)
  origin      String    @default("")
  price       Float     @default(0)
  imageUrl    String    @default("") @db.Text
  links       String    @default("") @db.Text
  version     Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}

model CustomerNumber {
  id           String @id @default(cuid())
  customerId   String
  orgId        String
  number       String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([customerId, orgId])
  @@unique([orgId, number])
}

model CustomerContact {
  id         String @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String @default("")
  email      String @default("")
  phone      String @default("")
  mobile     String @default("")
}

// ---- Projekt (geschäftlich) ----
model Project {
  id           String  @id @default(cuid())
  name         String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  color        String  @default("#7c3cc0")
  hourlyRate   Float   @default(0)
  status       String  @default("offen")
  teamLeaderId String?
  archived     Boolean @default(false)
  version      Int      @default(1)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([name])
}

// ---- Aufgabe (zentral; alle Apps arbeiten gemeinsam daran) ----
model Task {
  id          String  @id @default(cuid())
  title       String
  description String  @default("") @db.Text
  status      String  @default("offen")    // offen | laeuft | erledigt
  priority    String  @default("normal")   // niedrig | normal | hoch
  projectId   String?                       // zentrale Projekt-ID
  assigneeId  String?                       // zuständiger Mitarbeiter (Employee-ID)
  dueDate     DateTime?
  done        Boolean @default(false)
  appKey      String  @default("")          // optional: welche App die Aufgabe erstellt hat
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

// ---- Mitarbeiter (HR-Kern; Lohn bleibt in clocker) ----
model Employee {
  id             String  @id @default(cuid())
  name           String
  email          String  @default("")
  employeeNumber String  @default("")
  // Stammdaten für Personalunterlagen (Vorausfüllen von Formularen)
  phone          String  @default("")
  street         String  @default("")
  zip            String  @default("")
  city           String  @default("")
  birthDate      DateTime?
  nationality    String  @default("")
  color          String  @default("#7c3cc0")
  identityId     String?
  archived       Boolean @default(false)
  version        Int      @default(1)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

// ---- Zentrales Kontaktregister (alle Ansprechpartner aller Apps) ----
// Kontakte gehören Nexus: kontor (ClientContact) und ProjectEye (suppliers/savedEmails)
// werden beidseitig abgeglichen – Protokoll: /mnt/devip3/shared/sync/KONTAKTE.md
// Mehrere Kommunikationswege je Kontakt (mehrere E-Mails, Nummern, Webseiten).
// Der **erste** Eintrag je Art landet zusätzlich in Contact.email/phone/mobile –
// nur diese Hauptwerte gehen in den Abgleich mit kontor, clocker und ProjectEye.
model ContactChannel {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind      String  @default("email")     // email | phone | mobile | fax | web
  value     String
  label     String  @default("")          // z. B. „Zentrale", „privat", „Werkstatt"
  sort      Int     @default(0)

  @@index([contactId])
  @@index([value])
}

model Contact {
  id           String   @id @default(cuid())
  // Anzeigename (aus Vor- und Nachname zusammengesetzt) – ist die Grundlage des Abgleichs
  name         String
  firstName    String   @default("")
  lastName     String   @default("")
  role         String   @default("")            // Funktion, z. B. „Einkauf"
  email        String   @default("")
  phone        String   @default("")
  mobile       String   @default("")
  notes        String   @default("") @db.Text
  // Zugehörigkeit: zu welcher Firma gehört die Person?
  ownerKind    String   @default("frei")        // customer | supplier | organization | frei
  // Einordnung freier Kontakte, die zu keinem Stammdatensatz gehören –
  // z. B. „Vertreter", „Shop", „Handwerker". Frei wählbar, dient Filter und Suche.
  category     String   @default("")
  ownerId      String   @default("")            // Nexus-ID der Firma (leer bei „frei")
  ownerName    String   @default("")            // Firma: eingefroren; bei „frei" frei eintragbar
                                                 // (Shop-, Vertretungs- oder Firmenname ohne Stammsatz)
  // Echte Verknüpfung, damit Kunden-/Lieferantenlisten ihre Ansprechpartner mitladen
  // und die Suche sie findet. Wird zusammen mit ownerKind/ownerId gepflegt.
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  // Herkunft und stabile Verknüpfung in die Fachanwendungen
  source       String   @default("nexus")       // nexus | kontor | clocker | projecteye
  kontorId     String   @default("")            // kontor "ClientContact".id
  clockerId    String   @default("")            // clocker "ClientContact".id
  projecteyeId String   @default("")            // ProjectEye suppliers[].id bzw. savedEmails-Schlüssel
  // ---- Private Angaben ----
  // Bleiben **ausschließlich in Nexus**: Der Abgleich mit kontor, clocker und ProjectEye
  // überträgt nur die geschäftlichen Felder. In der Oberfläche sind sie zugeklappt.
  privatePhone  String   @default("")
  privateMobile String   @default("")
  privateEmail  String   @default("")
  privateStreet String   @default("")
  privateZip    String   @default("")
  privateCity   String   @default("")
  birthday      DateTime?                        // Geburtstag
  privateNotes  String   @default("") @db.Text
  channels     ContactChannel[]                 // weitere E-Mails, Nummern, Webseiten
  favorite     Boolean  @default(false)         // Schnellauswahl
  version      Int      @default(1)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerKind, ownerId])
  @@index([category])
  @@index([customerId])
  @@index([supplierId])
  @@index([name])
  @@index([email])
  @@index([kontorId])
  @@index([clockerId])
  @@index([projecteyeId])
}

// ---- Zentrale Identität (Login für ALLE Apps) ----
model Identity {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  // Zusätzlich das vergebene Passwort verschlüsselt (AES-256-GCM), damit ein Admin es
  // an den Mitarbeiter weitergeben kann. Wird NIE mit der Liste ausgeliefert, sondern
  // nur einzeln über /api/identities/[id]/password und nur für globale Admins.
  passwordEnc  String @default("") @db.Text
  name         String
  globalRole   String @default("user")
  employeeId   String?
  appAccess    IdentityAppAccess[]
  emails       IdentityEmail[]                  // weitere Anmelde-Adressen
  version      Int      @default(1)
  origin       String  @default("central")
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---- Weitere Anmelde-Adressen einer Identität ----
// Jeder darf sich mit mehreren Adressen anmelden – Firmen-Adresse, private Adresse und
// beliebige weitere. `Identity.email` bleibt die **Haupt**adresse: Sie geht an den
// Mitarbeiterstammsatz und in die Fachanwendungen; die übrigen gelten für die Anmeldung.
model IdentityEmail {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  email      String   @unique
  label      String   @default("")            // z. B. „privat", „alt", „Werkstatt"
  createdAt  DateTime @default(now())

  @@index([identityId])
}

model IdentityAppAccess {
  id          String  @id @default(cuid())
  identityId  String
  appKey      String
  allowed     Boolean @default(true)
  role        String  @default("user")
  rights      String  @default("{}")
  localUserId String?
  syncedAt    DateTime?
  identity    Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, appKey])
  @@index([appKey])
}

// ---- Undo/Redo: Revisionen jeder Schreiboperation ----
model Revision {
  id         String  @id @default(cuid())
  txId       String
  entity     String
  entityId   String
  action     String
  before     String? @db.Text
  after      String? @db.Text
  identityId String
  appKey     String
  undone     Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([txId])
  @@index([createdAt])
}

// ---- Locking: optionaler pessimistischer Edit-Lock ----
model EditLock {
  id         String  @id @default(cuid())
  entity     String
  entityId   String
  identityId String
  identityName String @default("")
  appKey     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([entity, entityId])
}

// ---- Arbeitsvertrag (HR-Dokument; Mitarbeiterdaten werden zum Vertragszeitpunkt eingefroren) ----
model EmploymentContract {
  id              String   @id @default(cuid())
  number          Int      @unique                       // fortlaufende Vertragsnummer (server-vergeben) → "AV-0001"
  title           String   @default("")                 // z. B. "Arbeitsvertrag – Max Mustermann"
  employeeId      String   @default("")                 // Referenz auf Employee (lose ID, wie Task.assigneeId)
  // Vertragsparteien (denormalisiert – Dokument bleibt eigenständig)
  employeeName    String   @default("")
  employeeAddress String   @default("")                 // Straße, PLZ Ort (mehrzeilig erlaubt)
  employeeBirth   String   @default("")                 // Geburtsdatum (Freitext, z. B. "01.01.1990")
  // Vertragsdaten
  jobTitle        String   @default("")                 // Tätigkeit / Position
  startDate       DateTime?                              // Eintrittsdatum
  contractType    String   @default("unbefristet")      // unbefristet | befristet
  endDate         DateTime?                              // bei Befristung
  probationMonths Int      @default(6)                   // Probezeit in Monaten (0 = keine)
  template        String   @default("vollstaendig")      // "standard" | "vollstaendig" (Klausel-Vorlage)
  // Arbeitszeitmodell: "flex" = Bandbreite mit Arbeitszeitkonto, "fest" = feste Zeiten
  workTimeModel   String   @default("flex")
  weeklyHours     Float    @default(40)                  // Wochenarbeitszeit (Legacy)
  weekHoursMin    Float    @default(32)                  // Flexarbeitszeit-Korridor von
  weekHoursMax    Float    @default(42)                  // Flexarbeitszeit-Korridor bis
  // Arbeitszeitkonto & Regelarbeitszeit-Rahmen
  timeAccount     Boolean  @default(true)                // Arbeitszeitkonto geführt (Plus-/Minusstunden)
  coreTimeFrom    String   @default("07:00")             // Regelarbeitszeit von
  coreTimeTo      String   @default("17:00")             // Regelarbeitszeit bis ("je nach Absprache")
  salary          Float    @default(0)                   // Bruttoentgelt
  salaryPeriod    String   @default("monatlich")         // monatlich | stündlich
  vacationDays    Int      @default(30)                  // Urlaubstage/Jahr
  noticeText      String   @default("gesetzliche Fristen") // Kündigungsfrist
  workplace       String   @default("Cloppenburg")       // Arbeitsort
  additionalTerms String   @default("") @db.Text          // freie Zusatzvereinbarungen
  signCity        String   @default("Cloppenburg")        // Unterschriftsort
  signDate        DateTime?                               // Datum der Unterzeichnung
  status          String   @default("entwurf")            // entwurf | aktiv | beendet
  archived        Boolean  @default(false)
  version         Int      @default(1)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ---- Dokumentenablage: Vorlagen (z. B. Personalfragebogen) ----
model DocumentTemplate {
  id        String   @id @default(cuid())
  key       String   @unique                  // technischer Schlüssel, z. B. "personalfragebogen-minijob"
  name      String                             // Anzeigename
  fileName  String                             // Original-Dateiname
  mimeType  String   @default("application/pdf")
  data      Bytes                              // die Vorlagendatei selbst
  version   Int      @default(1)               // erhöht sich bei jedem Ersetzen der Datei
  formFields String  @default("[]") @db.Text   // erkannte PDF-Formularfelder (JSON)
  fieldMap  String   @default("{}") @db.Text   // Zuordnung PDF-Feld → Nexus-Feld (JSON)
  note      String   @default("") @db.Text
  archived  Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Dokumentenablage: abgelegte Dokumente je Mitarbeiter ----
// ---- Netzwerk-Scanner (treiberlos über eSCL/AirScan) ----
model Scanner {
  id        String   @id @default(cuid())
  name      String                                // Anzeigename, z. B. „Büro oben"
  host      String                                // IP oder Hostname
  model     String   @default("")                 // vom Gerät gemeldet
  note      String   @default("")
  lastUsedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([host])
}

// ---- Posteingang für gescannte Dokumente ----
// Ein Scan landet zuerst hier („liegen lassen") und kann später einem Mitarbeiter und
// einer Rubrik zugeordnet werden – dann entsteht daraus ein EmployeeDocument.
model ScanDocument {
  id          String   @id @default(cuid())
  title       String                              // bearbeitbarer Name
  fileName    String                              // Dateiname für Download/Ablage
  mimeType    String   @default("application/pdf")
  data        Bytes
  size        Int      @default(0)
  pages       Int      @default(1)
  sha256      String   @default("")               // erkennt inhaltsgleiche Scans
  scannerName String   @default("")
  scannedAt   DateTime @default(now())            // Grundlage für den Tagesverlauf
  status      String   @default("offen")          // offen | zugeordnet
  employeeId  String   @default("")               // gesetzt beim Zuordnen
  groupId     String   @default("")               // Rubrik in der Akte
  documentId  String   @default("")               // daraus entstandenes EmployeeDocument
  note        String   @default("") @db.Text
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([scannedAt])
  @@index([sha256])
}

// ---- Ablage-Gruppe (Rubrik in der Mitarbeiterakte, z. B. „Krankenversicherung") ----
// Gilt für alle Mitarbeiter gleich: einmal anlegen, überall nutzbar.
model DocumentGroup {
  id        String   @id @default(cuid())
  name      String
  sort      Int      @default(0)               // Reihenfolge in der Akte
  color     String   @default("")              // optionale Farbmarkierung
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Notiz in der Mitarbeiterakte (frei, optional einer Gruppe zugeordnet) ----
model EmployeeNote {
  id         String   @id @default(cuid())
  employeeId String
  groupId    String   @default("")             // leer = Gruppe „Ohne Zuordnung"
  title      String   @default("")
  text       String   @default("") @db.Text
  author     String   @default("")             // wer sie angelegt hat (Anzeigename)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([groupId])
}

model EmployeeDocument {
  id          String   @id @default(cuid())
  employeeId  String
  groupId     String   @default("")            // Rubrik in der Akte (DocumentGroup)
  orgId       String   @default("")            // Firma/Mandant, zu der das Dokument gehört
  orgName     String   @default("")            // eingefroren für den Dateinamen
  templateId  String   @default("")
  templateKey String   @default("")
  title       String   @default("")
  fileName    String                            // erzeugter Name: Firma_ID_Dokument_Datum_vN.pdf
  mimeType    String   @default("application/pdf")
  data        Bytes
  size        Int      @default(0)
  version     Int      @default(1)              // laufende Version je Mitarbeiter + Vorlage
  filled      Boolean  @default(false)          // aus Nexus-Daten vorausgefüllt?
  sha256      String   @default("")              // Inhaltsprüfsumme (Duplikat-Warnung)
  note        String   @default("") @db.Text
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([groupId])
  @@index([templateKey])
  @@index([sha256])
}

// ---- Lieferant (zentral; Quelle bisher ProjectEye) ----
model Supplier {
  id            String   @id @default(cuid())
  number        Int      @unique                 // zentrale, fortlaufende Lieferantennummer (Nexus vergibt sie)
  name          String                            // Firmenname (ProjectEye: "firma")
  shortCode     String   @default("")             // Kürzel (ProjectEye: "kuerzel")
  contactName   String   @default("")             // Ansprechpartner
  email         String   @default("")
  phone         String   @default("")
  web           String   @default("")
  customerNumber String  @default("")             // unsere Kundennummer beim Lieferanten
  street        String   @default("")
  zip           String   @default("")
  city          String   @default("")
  country       String   @default("Deutschland")
  addressFree   String   @default("")             // unstrukturierte Anschrift (aus ProjectEye übernommen)
  taxNumber     String   @default("")
  ustId         String   @default("")
  category      String   @default("")
  notes         String   @default("") @db.Text
  projecteyeId  Int?                              // Verknüpfung zur ProjectEye-ID (Abgleich)
  contacts       Contact[]                      // zentrales Kontaktregister
  legacyContacts SupplierContact[]               // Altbestand vor der Zentralisierung (nur Archiv)
  archived      Boolean  @default(false)
  version       Int      @default(1)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([shortCode])
  @@index([projecteyeId])
}

// ---- Ansprechpartner eines Lieferanten ----
model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  role       String   @default("")
  email      String   @default("")
  phone      String   @default("")
  mobile     String   @default("")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([name])
}
